# Copy to .env for local development.
#
# Used when the browser does not send its own X-API-Key header. Every user of
# the deployed app can paste their own DeepSeek key in the setup screen, so this
# is only a fallback (a shared key for a private deployment, for example).
DEEPSEEK_API_KEY=

# Port of the local Express server (server.js). Vercel ignores it.
PORT=3000
